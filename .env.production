# Production Environment

# Domain
DOMAIN=wise2.net
API_URL=https://api.wise2.net

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wise2_prod
DB_USER=wise2_user
DB_PASSWORD=CHANGE_ME

# Redis
REDIS_URL=redis://redis:6379

# API
API_PORT=8000
NODE_ENV=production
LOG_LEVEL=info

# Security
JWT_SECRET=CHANGE_ME
API_KEY_PREFIX=sk-prod-

# Features
ENABLE_VR=true
ENABLE_TRADING=true
ENABLE_AI=true
ENABLE_3D_PRINT=true

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME

# Analytics
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=
