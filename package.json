{
  "name": "wise2-ecosystem",
  "version": "1.0.0",
  "description": "Complete platform for Web, AI, Gaming, 3D, Trading & IoT",
  "author": "WISE² Team",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "http-server -p 3000 -c-1 -o",
    "dev": "http-server -p 3000 --watch",
    "build": "npm run lint && npm run test",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "format": "prettier --write .",
    "audit": "npm audit && lighthouse http://localhost:3000/index.html --output-path=./lighthouse-report.html",
    "bundle": "esbuild ai-tools/*.js --bundle --minify --outdir=dist",
    "analyze": "node scripts/analyze-bundle.js",
    "deploy": "npm run build && npm run bundle && echo 'Ready for production'",
    "docs": "jsdoc -c jsdoc.json",
    "serve:docs": "http-server ./docs -p 8080"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chart.js": "^4.4.0",
    "lightweight-charts": "^4.1.0",
    "lodash-es": "^4.17.21",
    "three": "^r128",
    "babylon.js": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@eslint/js": "^8.50.0",
    "@testing-library/dom": "^9.3.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.50.0",
    "eslint-plugin-a11y": "^6.7.0",
    "jest": "^29.7.0",
    "jest-dom": "^6.1.4",
    "jsdoc": "^4.0.2",
    "lighthouse": "^11.0.0",
    "prettier": "^3.0.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  }
}
